{
  "name": "danmaku-dashboard",
  "productName": "弹幕看板",
  "version": "0.2.0",
  "description": "B站与抖音公开直播间的本地实时弹幕采集与看板",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "generate:icons": "node scripts/generate-icons.mjs",
    "prepare:electron-zip": "node scripts/prepare-electron-zip.mjs",
    "package:mac": "npm run prepare:electron-zip -- --platform=darwin --arch=arm64 && electron-forge package --platform=darwin --arch=arm64",
    "make:mac": "npm run prepare:electron-zip -- --platform=darwin --arch=arm64 && electron-forge make --platform=darwin --arch=arm64",
    "package:win": "npm run prepare:electron-zip -- --platform=win32 --arch=x64 && electron-forge package --platform=win32 --arch=x64",
    "make:win": "npm run prepare:electron-zip -- --platform=win32 --arch=x64 && electron-forge make --platform=win32 --arch=x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts/**/*.ts forge.config.ts vite.main.config.ts vite.preload.config.ts vite.worker.config.ts vite.renderer.config.ts vitest.config.ts",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:privacy": "node scripts/check-sensitive-artifacts.mjs",
    "test:performance:smoke": "vite-node scripts/benchmark-storage.ts --profile=smoke",
    "test:performance:million": "node scripts/run-packaged-benchmark.mjs --profile=million",
    "verify:fast": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:privacy",
    "verify:release": "npm run verify:release:mac",
    "verify:release:mac": "npm run verify:fast && npm run test:performance:smoke && npm run test:package:mac && npm run test:performance:million",
    "probe:douyin": "node --no-warnings scripts/probe-douyin-protocol.ts",
    "test:live-protocol": "vite-node scripts/probe-bilibili-protocol.ts",
    "test:douyin-dashboard": "node --no-warnings scripts/verify-douyin-dashboard.mjs",
    "test:package": "npm run test:package:mac",
    "test:package:mac": "node scripts/verify-macos-artifact.mjs",
    "test:package:win": "node scripts/verify-windows-artifact.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-base": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@types/yazl": "2.4.6",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.7",
    "electron": "43.2.0",
    "eslint": "10.8.0",
    "jsdom": "29.1.1",
    "png2icons": "2.0.1",
    "prettier": "3.9.6",
    "resedit": "2.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-node": "6.0.0",
    "vitest": "4.1.7",
    "yazl": "3.3.1"
  }
}
